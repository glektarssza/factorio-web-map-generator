{
    "folders": [
        {
            "name": "Repository Template",
            "path": ".."
        }
    ],
    "settings": {
        "[json]": {
            "editor.formatOnPaste": true,
            "editor.formatOnSave": true,
            "editor.formatOnSaveMode": "file",
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
            "editor.formatOnPaste": true,
            "editor.formatOnSave": true,
            "editor.formatOnSaveMode": "file",
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonl]": {
            "editor.formatOnPaste": true,
            "editor.formatOnSave": true,
            "editor.formatOnSaveMode": "file",
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "bashIde.globPattern": "**/*@(.sh|.inc|.bash|.command|.zsh)",
        "bashIde.includeAllWorkspaceSymbols": true,
        "bashIde.shellcheckPath": "/usr/bin/shellcheck",
        "bashIde.shfmt.binaryNextLine": true,
        "bashIde.shfmt.caseIndent": true,
        "bashIde.shfmt.funcNextLine": false,
        "bashIde.shfmt.languageDialect": "auto",
        "bashIde.shfmt.path": "/usr/bin/shfmt",
        "bashIde.shfmt.simplifyCode": true,
        "bashIde.shfmt.spaceRedirects": true,
        "factorio.docs.generateDocs": true,
        "factorio.package.movedToCommitMessage": "Release version v$VERSION.",
        "factorio.package.preparingCommitMessage": "Prepare for releasing version v$VERSION.",
        "factorio.package.tagMessage": "v$VERSION",
        "factorio.package.tagName": "v$VERSION",
        "factorio.package.zipLocation": "outside",
        "factorio.workspace.manageLibraryDataLinks": true,
        "prettier.configPath": ".prettierrc.mjs",
        "prettier.ignorePath": ".prettierignore",
        "shellcheck.enable": false
    }
}
